// Unsigned and narrow integers, and casts between them.

// Can overflow: 255 + 1.
fn add_u8(a: u8, b: u8) -> u8 {
    a + b
}

// Cannot: the casts widen, so the sum is at most 510.
fn widen(a: u8, b: u8) -> u64 {
    a as u64 + b as u64
}

// Can go below zero: 0 - 1.
fn sub_u64(a: u64, b: u64) -> u64 {
    a - b
}

// Cannot: the branch rules it out.
fn guarded_sub(a: u64, b: u64) -> u64 {
    if b <= a { a - b } else { 0 }
}

// i32 counters under a bound.
fn bounded(x: i32) -> i32 {
    x * 2 + 1
}

fn main() {
    println(
        add_u8(1, 2) as u64 + widen(1, 2) + sub_u64(3, 1) + guarded_sub(1, 2) + bounded(3) as u64
    )
}
