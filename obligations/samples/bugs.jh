// What must not be proved, from real compiler output, next to one thing
// that must.

// Off by one: `xs[i]` with `i == xs.len` is out of bounds.
fn last(xs: [i64]) -> i64 {
    var s = 0
    var i = 0
    while i <= xs.len {
        s = xs[i]
        i += 1
    }
    s
}

fn bump(inout x: i64) {
    x += 1
}

// `x` changes through the borrow `bump` takes: its value after the call is
// not `n`.
fn after_call(n: i64) -> i64 {
    var x = n
    bump(&x)
    x
}

// A multiplication by a constant is linear.
fn scale(x: i64) -> i64 {
    x * 4
}

fn main() {
    println(last([1, 2]) + after_call(1) + scale(2))
}
