// The functions of models.jh, as source: `emit-obligations` of this file
// must give the same verdicts as the hand-written models.
fn clamp(x: i64, lo: i64, hi: i64) -> i64 {
    if x < lo { return lo }
    if x > hi { return hi }
    x
}

fn sum(xs: [i64]) -> i64 {
    var s = 0
    var i = 0
    while i < xs.len {
        s += xs[i]
        i += 1
    }
    s
}

fn main() {
    println(clamp(5, 0, 3).to_string() + sum([1, 2]).to_string())
}
