// Generates a function's obligations, asks the untrusted prover for each
// certificate and accepts only what the trusted checker accepts.
import fm
import linear
import vc

pub enum Verdict {
    // The checked certificate's number of facts used.
    Proved(i64)
    Unproved(String)
}

pub struct Result1 {
    pub what: String
    // Where the claim's variables come from (`vc.why_code`s).
    pub depends: Vec(i64)
    // The check's span, `vc.nowhere()` for invariants and `ensures`.
    pub at: (i64, i64)
    pub verdict: Verdict
}

pub struct Report {
    pub function: String
    pub results: Vec(Result1)
    pub errors: Vec(String)
}

impl Report {
    pub fn proved(self) -> i64 {
        var n = 0
        for r in self.results {
            match r.verdict {
                Proved(_) => n += 1
                Unproved(_) => {}
            }
        }
        n
    }

    // What stopped the generator, in a word.
    fn error_kind(self) -> str {
        let e = self.errors[0].as_str()
        if e.contains("loop without an invariant") { return "loop" }
        if e.contains(" paths") { return "paths" }
        if e.contains(" is reached") { return "unreachable" }
        if e.contains("not linear") { return "ne" }
        "fact"
    }

    pub fn complete(self) -> bool {
        self.errors.len() == 0 && self.proved() == self.results.len()
    }

    // One line per check with a span, then the function's `ensures`, for
    // differential.py: `check NAME LO HI proved|unproved`,
    // `requires NAME LO HI CALLEE proved|unproved` for a call's `requires`,
    // and `ensures NAME proved|unproved` (proved when every return meets it).
    // A function the generator did not follow everywhere proves nothing:
    // a check proved on the paths it saw may fail on another.
    pub fn machine(self) -> String {
        var out = String.new()
        let whole = self.errors.len() == 0
        var ensures = true
        for r in self.results {
            let proved = match r.verdict {
                Proved(_) => true
                Unproved(_) => false
            }
            let verdict = if proved && whole { "proved" } else { "unproved" }
            let call = r.what.as_str().find(": requires of ")
            if r.at.0 >= 0 && call.is_some() {
                let callee = r.what.as_str()[call.unwrap() + 14..]
                out += "requires " + self.function.as_str() + " " + r.at.0.to_string() + " " +
                    r.at.1.to_string() + " " + callee + " " + verdict + "\n"
            } else if r.at.0 >= 0 {
                out += "check " + self.function.as_str() + " " + r.at.0.to_string() + " " +
                    r.at.1.to_string() + " " + verdict
                // Why: the function was not followed everywhere, or where the
                // claim's values come from.
                if !whole {
                    out += " incomplete:" + self.error_kind()
                } else if !proved {
                    out += " "
                    for i, d in r.depends {
                        if i > 0 { out += "," }
                        out += vc.why_name(d)
                    }
                }
                out += "\n"
            }
            if r.what.as_str().ends_with(": ensures") && !proved { ensures = false }
        }
        if self.errors.len() > 0 { ensures = false }
        out += "ensures " + self.function.as_str() + " " + (
            if ensures { "proved" } else { "unproved" }
        ) + "\n"
        out
    }

    pub fn text(self) -> String {
        var out = self.function.as_str() + ": " + self.proved().to_string() + " of " +
            self.results.len().to_string() + " obligations proved"
        // With errors some paths were not followed, so nothing is proved.
        if self.errors.len() > 0 { out += " on the paths followed; INCOMPLETE" }
        out += "\n"
        for r in self.results {
            match r.verdict {
                Proved(n) => out += "  proved   " + r.what.as_str() + " (" + n.to_string() + " facts)\n"
                Unproved(why) => out += "  UNPROVED " + r.what.as_str() + ": " + why.as_str() + "\n"
            }
        }
        for e in self.errors { out += "  error    " + e.as_str() + "\n" }
        out
    }
}

pub fn verify(f: vc.Function) -> Report {
    let none = Vec(vc.Function).new()
    verify_with(f, none.as_slice())
}

// The same, with the contracts of the functions in `all` at calls to them.
pub fn verify_with(f: vc.Function, all: [vc.Function]) -> Report {
    let obs = vc.generate_with(f, all)
    var results = Vec(Result1).new()
    for o in obs.list {
        let verdict = match fm.prove(o.goal) {
            Ok(c) => match linear.check(o.goal, c) {
                Ok(n) => Verdict.Proved(n)
                Err(e) => Verdict.Unproved("the checker rejected the prover: " + e.as_str())
            }
            Err(e) => Verdict.Unproved(e.to_string())
        }
        results.push(Result1 {
            what: o.what.clone(),
            depends: o.depends.clone(),
            at: o.at,
            verdict
        })
    }
    Report { function: f.name.clone(), results, errors: obs.errors.clone() }
}
