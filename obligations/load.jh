// Reads `jihoo emit-obligations` output into the model, with each
// function's contract (requires, ensures, loop invariants) as the source
// states it. Reading is trusted: it is part of the semantics.
import linear
import sexp
import vc

fn int(x: sexp.Sexp) -> Result(i128, String) {
    let text = x.atom()?
    var v: i128 = 0
    var negative = false
    var i = 0
    if text.len > 0 && text.as_bytes()[0] == '-' {
        negative = true
        i = 1
    }
    if i == text.len { return Err("expected an integer, found `" + text + "`") }
    while i < text.len {
        let c = text.as_bytes()[i]
        if c < '0' || c > '9' { return Err("expected an integer, found `" + text + "`") }
        // Negative accumulation reaches the most negative i128.
        let min: i128 = 0 - (1 << 126) - (1 << 126)
        let d = (c - '0') as i128
        if v < min / 10 || v * 10 < min + d { return Err("`" + text + "` does not fit an i128") }
        v = v * 10 - d
        i += 1
    }
    if !negative && v == 0 - (1 << 126) - (1 << 126) { return Err(
        "`" + text + "` does not fit an i128"
    ) }
    Ok(if negative { v } else { 0 - v })
}

// Within 64 bits, signed or unsigned.
fn small(v: i128) -> bool { v >= 0 - (1 << 63) && v < (1 << 64) }

fn index(x: sexp.Sexp) -> Result(i64, String) { Ok(int(x)? as i64) }

fn head(x: sexp.Sexp, name: str, n: i64) -> Result([sexp.Sexp], String) {
    let xs = x.list()?
    if xs.len != n + 1 || xs[0].atom()? != name {
        return Err("expected (" + name + " ...) with " + n.to_string() + " parts")
    }
    Ok(xs[1..xs.len])
}

// `(at lo hi)`: a check's span.
fn at(x: sexp.Sexp) -> Result((i64, i64), String) {
    let ps = head(x, "at", 2)?
    Ok((index(ps[0])?, index(ps[1])?))
}

// The reason of `(opaque why)`; a bare `opaque` has none.
fn why(x: sexp.Sexp) -> i64 {
    match x {
        List(xs) => if xs.len() == 2 {
            match xs[1].atom() {
                Ok(w) => vc.why_code(w)
                Err(_) => vc.WHY_OTHER
            }
        } else { vc.WHY_OTHER }
        Atom(_) => vc.WHY_OTHER
    }
}

fn tag(x: sexp.Sexp) -> Result(str, String) {
    match x {
        Atom(a) => Ok(a.as_str())
        List(xs) => if xs.len() > 0 { xs[0].atom() } else { Err("empty form") }
    }
}

fn operand(x: sexp.Sexp) -> Result(vc.Operand, String) {
    match tag(x)? {
        "opaque" => Ok(vc.Operand.Opaque(why(x)))
        "local" => Ok(vc.Operand.Local(index(head(x, "local", 1)?[0])?))
        "const" => match int(head(x, "const", 1)?[0]) {
            Ok(c) => if small(c) { Ok(vc.Operand.Const(c)) } else { Ok(vc.Operand.Opaque(vc.why_code(
                "constant"
            ))) }
            Err(_) => Ok(vc.Operand.Opaque(vc.why_code("constant")))
        }
        t => Err("unknown operand `" + t + "`")
    }
}

fn argument(x: sexp.Sexp) -> Result(vc.Arg, String) {
    match tag(x)? {
        "view" => Ok(vc.Arg.View(index(head(x, "view", 1)?[0])?))
        "lent" => Ok(vc.Arg.Lent(index(head(x, "lent", 1)?[0])?))
        _ => Ok(vc.Arg.Value(operand(x)?))
    }
}

// `(lin c (v k)...)`: `c` plus `k` times each variable `v`; None for
// `(opaque why)`, which the model does not follow.
fn form(x: sexp.Sexp, vars: i64) -> Result(Option(linear.Lin), String) {
    if tag(x)? == "opaque" { return Ok(None) }
    let xs = x.list()?
    if xs.len < 2 || xs[0].atom()? != "lin" { return Err("expected (lin c (v k)...)") }
    let c = int(xs[1])?
    if !small(c) { return Ok(None) }
    var out = linear.Lin.num(c)
    for i in 2..xs.len {
        let ps = xs[i].list()?
        if ps.len != 2 { return Err("expected (variable coefficient)") }
        let v = index(ps[0])?
        let k = int(ps[1])?
        if v < 0 || v >= vars { return Err("no variable " + v.to_string()) }
        if !small(k) { return Ok(None) }
        out = out.plus(linear.Lin.of(v).scale(k))
    }
    Ok(Some(out))
}

// `(op A B)`, a clause of a contract.
fn clause(x: sexp.Sexp, vars: i64) -> Result(vc.Fact, String) {
    let xs = x.list()?
    if xs.len != 3 { return Err("expected (op a b)") }
    let op = cmp(xs[0].atom()?)?
    match (form(xs[1], vars)?, form(xs[2], vars)?) {
        (Some(a), Some(b)) => Ok(vc.linear_fact(op, a, b))
        _ => Ok(vc.unstated(op))
    }
}

fn pairs(x: sexp.Sexp, name: str) -> Result(Vec((i64, i64)), String) {
    let xs = x.list()?
    if xs.len == 0 || xs[0].atom()? != name { return Err("expected (" + name + " ...)") }
    var out = Vec((i64, i64)).new()
    for p in xs[1..] {
        let ps = p.list()?
        if ps.len != 2 { return Err("expected (a b) in " + name) }
        out.push((index(ps[0])?, index(ps[1])?))
    }
    Ok(out)
}

fn cmp(name: str) -> Result(vc.Cmp, String) {
    match name {
        "lt" => Ok(vc.Cmp.Lt)
        "le" => Ok(vc.Cmp.Le)
        "gt" => Ok(vc.Cmp.Gt)
        "ge" => Ok(vc.Cmp.Ge)
        "eq" => Ok(vc.Cmp.Eq)
        "ne" => Ok(vc.Cmp.Ne)
        _ => Err("unknown comparison `" + name + "`")
    }
}

fn rvalue(x: sexp.Sexp) -> Result(vc.Rvalue, String) {
    let t = tag(x)?
    if t == "opaque" { return Ok(vc.Rvalue.Opaque(why(x))) }
    let xs = x.list()?
    match t {
        "use" => Ok(vc.Rvalue.Use(operand(head(x, "use", 1)?[0])?))
        "add" => Ok(vc.Rvalue.Add(operand(head(x, "add", 2)?[0])?, operand(xs[2])?))
        "sub" => Ok(vc.Rvalue.Sub(operand(head(x, "sub", 2)?[0])?, operand(xs[2])?))
        "mul" => Ok(vc.Rvalue.Mul(operand(head(x, "mul", 2)?[0])?, operand(xs[2])?))
        "and" => Ok(vc.Rvalue.And(operand(head(x, "and", 2)?[0])?, operand(xs[2])?))
        "not" => Ok(vc.Rvalue.Not(operand(head(x, "not", 1)?[0])?))
        "cast" => Ok(vc.Rvalue.Cast(operand(head(x, "cast", 1)?[0])?))
        "cmp" => {
            let ps = head(x, "cmp", 3)?
            Ok(vc.Rvalue.Compare(cmp(ps[0].atom()?)?, operand(ps[1])?, operand(ps[2])?))
        }
        _ => Err("unknown value `" + t + "`")
    }
}

fn term(x: sexp.Sexp) -> Result(vc.Term, String) {
    let t = tag(x)?
    let xs = x.list()?
    match t {
        "goto" => Ok(vc.Term.Goto(index(head(x, "goto", 1)?[0])?))
        "switch" => {
            let ps = head(x, "switch", 3)?
            Ok(vc.Term.Switch(index(ps[0])?, index(ps[1])?, index(ps[2])?))
        }
        "assert" => {
            if xs.len != 4 && xs.len != 5 { return Err("expected (assert c msg next [at])") }
            let c = match operand(xs[1])? {
                Local(l) => l
                _ => -1
            }
            let place = if xs.len == 5 { at(xs[4])? } else { vc.nowhere() }
            Ok(vc.Term.Assert(c, xs[2].atom()?.to_string(), index(xs[3])?, place))
        }
        "any" => {
            var bs = Vec(i64).new()
            for i in 1..xs.len { bs.push(index(xs[i])?) }
            Ok(vc.Term.Any(bs))
        }
        // `(call DST NEXT [(fn SYMBOL)] (args A...) (at lo hi))`.
        "call" => {
            if xs.len < 3 { return Err("expected (call dst next ...)") }
            let dst = if xs[1].atom()? == "_" { -1 } else { index(xs[1])? }
            var site = vc.no_site()
            for i in 3..xs.len {
                match tag(xs[i])? {
                    "fn" => site.callee = head(xs[i], "fn", 1)?[0].atom()?.to_string()
                    "args" => {
                        for a in xs[i].list()?[1..] { site.args.push(argument(a)?) }
                    }
                    "at" => site.at = at(xs[i])?
                    t => return Err("unknown part of a call `" + t + "`")
                }
            }
            Ok(vc.Term.Call(dst, index(xs[2])?, site))
        }
        "trap" => Ok(vc.Term.Trap)
        "return" => Ok(vc.Term.Return)
        "unreachable" => Ok(vc.Term.Unreachable)
        _ => Err("unknown terminator `" + t + "`")
    }
}

fn kind(x: sexp.Sexp) -> Result(vc.Kind, String) {
    match tag(x)? {
        // Ranges beyond 64 bits (`i128`, `u128`) are not followed: the
        // checker computes with i128 and keeps its numbers below 2^65.
        "int" => {
            let ps = head(x, "int", 2)?
            match (int(ps[0]), int(ps[1])) {
                (Ok(lo), Ok(hi)) => if small(lo) && small(hi) {
                    Ok(vc.Kind.Int(lo, hi))
                } else { Ok(vc.Kind.Other) }
                _ => Ok(vc.Kind.Other)
            }
        }
        "bool" | "other" => Ok(vc.Kind.Other)
        t => Err("unknown kind `" + t + "`")
    }
}

// `(function NAME SYMBOL (args N) (locals ...) (lengths ...) (derefs ...)
// (entries ...) (requires ...)... (ensures ...)... (invariant B ...)...
// (block 0 ...)...)`.
fn function(x: sexp.Sexp) -> Result(vc.Function, String) {
    let xs = x.list()?
    if xs.len < 5 || xs[0].atom()? != "function" { return Err("expected (function ...)") }
    var locals = Vec(vc.Decl).new()
    let ks = xs[4].list()?
    for i in 1..ks.len {
        locals.push(vc.Decl { name: "_" + (i - 1).to_string(), kind: kind(ks[i])? })
    }
    let vars = locals.len()
    var f = vc.function(xs[1].atom()?, locals, Vec(vc.Block).new())
    f.symbol = xs[2].atom()?.to_string()
    f.args = index(head(xs[3], "args", 1)?[0])?
    var blocks = Vec(vc.Block).new()
    for j in 5..xs.len {
        let ps = xs[j].list()?
        match tag(xs[j])? {
            "lengths" => f.lengths = pairs(xs[j], "lengths")?
            "derefs" => f.derefs = pairs(xs[j], "derefs")?
            "entries" => f.entries = pairs(xs[j], "entries")?
            // Each clause with its span, `(requires (op A B) (at lo hi))`.
            "requires" => {
                if ps.len != 3 { return Err("expected (requires clause (at lo hi))") }
                f.requires.push(clause(ps[1], vars)?)
            }
            "ensures" => {
                if ps.len != 3 { return Err("expected (ensures clause (at lo hi))") }
                f.ensures.push(clause(ps[1], vars)?)
            }
            "invariant" => {
                if ps.len != 4 { return Err("expected (invariant block clause (at lo hi))") }
                let b = index(ps[1])?
                let c = clause(ps[2], vars)?
                var found = false
                for i in 0..f.invariants.len() {
                    if f.invariants[i].0 == b {
                        f.invariants[i].1.push(c.clone())
                        found = true
                    }
                }
                if !found {
                    var cs = Vec(vc.Fact).new()
                    cs.push(c)
                    f.invariants.push((b, cs))
                }
            }
            "block" => {
                if ps.len < 3 || index(ps[1])? != blocks.len() {
                    return Err("expected (block " + blocks.len().to_string() + " ...)")
                }
                var stmts = Vec(vc.Stmt).new()
                for k in 2..ps.len - 1 {
                    let qs = ps[k].list()?
                    if (qs.len != 3 && qs.len != 4) || qs[0].atom()? != "set" {
                        return Err("expected (set local value [at])")
                    }
                    let place = if qs.len == 4 { at(qs[3])? } else { vc.nowhere() }
                    stmts.push(vc.Stmt.Assign(index(qs[1])?, rvalue(qs[2])?, place))
                }
                blocks.push(vc.Block { stmts, term: term(ps[ps.len - 1])? })
            }
            t => return Err("unknown part of a function `" + t + "`")
        }
    }
    for p in f.lengths {
        if p.1 >= vars { return Err("no variable " + p.1.to_string()) }
    }
    for p in f.derefs {
        if p.1 >= vars { return Err("no variable " + p.1.to_string()) }
    }
    for p in f.entries {
        if p.0 >= vars || p.1 >= vars { return Err("no variable in entries") }
    }
    f.blocks = blocks
    Ok(f)
}

pub fn functions(text: str) -> Result(Vec(vc.Function), String) {
    var out = Vec(vc.Function).new()
    for x in sexp.parse(text)? { out.push(function(x)?) }
    Ok(out)
}
