import std.env
import std.fs
import std.io
import std.sys
import kernel

// The standard library's file errors are `String`s up to jihoo 0.2 and
// `os.Error`s after; both have `to_string`.
fn text(comptime T: type, comptime E: type, sink r: Result(T, E)) -> Result(T, String) {
    match r {
        Ok(v) => Ok(v)
        Err(e) => Err(e.to_string())
    }
}

fn run() -> Result(kernel.Report, String) {
    let args = env.args()
    if args.len() != 4 { return Err("usage: kernel THEORY GOALS PROOF") }
    let source = text(fs.read_file(args[1]))?
    let th = kernel.Theory.parse(source.as_str())?
    let goals = text(fs.read_file(args[2]))?
    let reader = text(io.BufReader.open(args[3]))?
    th.check_reader(goals.as_str(), reader)
}

fn main() {
    match run() {
        Ok(r) => println("ACCEPT: " + r.goals.to_string() + " goals, " + r.steps.to_string() +
            " proof steps, " + r.bytes.to_string() + " bytes, " + r.terms.to_string() + " distinct terms")
        Err(e) => {
            eprintln("REJECT: " + e.as_str())
            sys.exit(1)
        }
    }
}
